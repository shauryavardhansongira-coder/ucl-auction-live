{
  // ============================================================
  // Identity model
  // ------------------------------------------------------------
  // Every client signs in with Firebase Anonymous Auth, so every
  // write carries a uid. Reads stay open to anyone holding the
  // twelve-character room key — viewers must keep working with no
  // sign-in and no seat — but writes are now attributable:
  //
  //   host/uid   the browser that claimed the room. Only it may
  //              write auction state, seats, or clear requests.
  //   seats/mN   a named manager slot; carries the manager index,
  //              the display name, and the uid holding it (if any).
  //   requests   pending first-time claims, keyed by the asking uid.
  //   lot        the player currently on the block, and the live
  //              bidding on it. The host opens and closes it; the
  //              seated managers raise it. This is the only node a
  //              manager writes during an auction.
  //
  // A '.write' granted at an ancestor cascades down and cannot be
  // revoked by a child, so there is deliberately NO '.write' at
  // $room: one there would hand every signed-in client the auction
  // state. The room-key pattern is instead re-checked inside every
  // child '.write' below, so it is still enforced in '.write' on
  // every reachable path and not only in '.validate'.
  //
  // What these rules deliberately do NOT enforce: whether a manager can
  // AFFORD the bid they are placing. The max bid is (remaining budget −
  // remaining slots × minimum bid), which needs that manager's whole
  // squad and the league's numbers out of CONFIG — none of which is
  // reachable from here. Affordability is therefore a CLIENT-SIDE check
  // only, and a hand-written request could bid straight past it.
  // Everything else about a bid — that the bidder holds the seat they
  // claim to be, that the price only ever goes up, and that it goes up
  // by exactly 1, 5 or 10 — is enforced below.
  // ============================================================

  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": false,
      ".write": false,

      "$room": {
        ".read": "$room.matches(/^[a-hjkmnp-z2-9]{12}$/)",
        ".validate": "$room.matches(/^[a-hjkmnp-z2-9]{12}$/)",

        // Claiming the room. Any signed-in client may take an unclaimed
        // or stale room — that is what lets a host reload, and what lets
        // a crashed host's room free itself — but only as itself: the uid
        // written must be the caller's own. The monotonic heartbeat is
        // what stops a straggler overwriting the live host. '.validate'
        // is skipped on deletes, so onDisconnect().remove() still frees
        // the room.
        "host": {
          ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/)",
          ".validate": "newData.hasChildren(['sessionId', 'uid', 'heartbeatAt']) && newData.child('uid').val() === auth.uid && (!data.exists() || newData.child('heartbeatAt').val() > data.child('heartbeatAt').val())",

          "sessionId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
          "uid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "heartbeatAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        // The auction itself. Only the uid recorded in the host claim may
        // write it, so every published snapshot is attributable to the
        // browser holding the room. Shape validation is unchanged.
        "state": {
          ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && root.child('rooms').child($room).child('host').child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['schema', 'updatedAt'])",

          "schema": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },

          "lot": {
            ".validate": "newData.hasChild('id')",
            "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "$other": { ".validate": false }
          },

          "players": {
            "$index": {
              ".validate": "newData.hasChildren(['id', 'status'])",
              "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
              "status": { ".validate": "newData.isString() && (newData.val() === 'sold' || newData.val() === 'unsold')" },
              "owner": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 63" },
              "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
              "$other": { ".validate": false }
            }
          },

          "log": {
            "$index": {
              ".validate": "newData.hasChildren(['seq', 'type', 'text'])",
              "seq": { ".validate": "newData.isNumber()" },
              "ts": { ".validate": "newData.isNumber()" },
              "type": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "text": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "undone": { ".validate": "newData.isBoolean()" },
              "owners": {
                "$slot": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 63" }
              },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        },

        // Named manager slots. The host creates them, approves the first
        // claim on each, and releases a device off one; all of that runs
        // through this host-only '.write'. A seat's name and manager
        // index are the host's to set and nobody else's.
        "seats": {
          ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && root.child('rooms').child($room).child('host').child('uid').val() === auth.uid",

          "$seat": {
            // The one write a non-host may make anywhere in a room, and it
            // is not a self-approval. It is possible only on a seat the
            // host has already created AND explicitly released (open ===
            // true, no holder); it may write no uid but the caller's own;
            // and it must carry the seat's existing manager index and name
            // through untouched, so a claimant can never rename a seat or
            // point it at a different manager. Release is what re-opens a
            // seat, so a device switch costs the host one tap and the
            // claimant one tap with no second approval — while a seat the
            // host has never opened stays unclaimable without one.
            ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && data.exists() && newData.exists() && data.child('open').val() === true && !data.child('uid').exists() && newData.child('uid').val() === auth.uid && newData.child('manager').val() === data.child('manager').val() && newData.child('name').val() === data.child('name').val() && !newData.child('open').exists()",

            ".validate": "$seat.matches(/^m[0-9]{1,2}$/) && newData.hasChildren(['manager', 'name'])",

            "manager": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 63" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "uid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "open": { ".validate": "newData.isBoolean() && newData.val() === true" },
            "$other": { ".validate": false }
          }
        },

        // Pending first-time claims, keyed by the requesting uid so a
        // device can only ever speak for itself and can only have one
        // request outstanding. The host writes here too — approving or
        // rejecting clears the request. A request may only name a seat
        // that exists and is not already held; '.validate' is skipped on
        // deletes, so cancelling and rejecting stay unconditional.
        "requests": {
          ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && root.child('rooms').child($room).child('host').child('uid').val() === auth.uid",

          "$uid": {
            ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && auth.uid === $uid",
            ".validate": "newData.hasChildren(['seat', 'at']) && root.child('rooms').child($room).child('seats').child(newData.child('seat').val()).exists() && !root.child('rooms').child($room).child('seats').child(newData.child('seat').val()).child('uid').exists()",

            "seat": { ".validate": "newData.isString() && newData.val().matches(/^m[0-9]{1,2}$/)" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        // ============================================================
        // The open lot. One node carries the whole of live bidding:
        //
        //   lot/player       who is on the block             host only
        //   lot/openedAt     when it was opened              host only
        //   lot/paused       true while frozen               host only
        //   lot/remainingMs  ms banked when it froze         host only
        //   lot/bid          { seq, price, seat, uid, at,
        //                      deadline }                    the room
        //
        // THE CLOCK. `bid/deadline` is when this lot ends, in server time.
        // It sits inside `bid` and not beside `openedAt` because a late bid
        // must extend it IN THE SAME WRITE that raises the price — a bid
        // that loses the race must not have bought time — and a transaction
        // runs on one node. The host is the only writer that may set it from
        // nothing or clear it: the manager rule below requires a deadline to
        // already exist, so a manager can only ever push an existing one
        // later, never create, clear or shorten one.
        //
        // PAUSE is published state, not a stopped local timer. The host sets
        // `paused`, banks what was left in `remainingMs`, and clears
        // `bid/deadline` — all in one update. Clearing the deadline is what
        // makes this rule refuse every bid while paused, and the explicit
        // `paused` clause below says so a second time on purpose. Only the
        // host writes any of the three; nothing outside the host grant
        // reaches `lot/paused` or `lot/remainingMs` at all.
        //
        // What these rules still cannot do is decide that a lot has ENDED.
        // `now` tells them whether a write is late, and that is enough to
        // refuse a late bid — but nothing here can write the sale, so
        // resolution stays the host's job and its once-only-ness is enforced
        // by the host being the only writer of `state` (see above) rather
        // than by anything in this file.
        //
        // Price and winning seat live in the SAME node on purpose. Split
        // across two nodes they would need two writes, and between those
        // two writes the price would have moved while the winner had not —
        // exactly the interleaving the client's runTransaction on this
        // node exists to prevent.
        //
        // `seq` stamps one opening of one lot; a bidder must echo it back
        // unchanged, so a tap still in flight when the host moves on cannot
        // land on the next player's lot.
        //
        // Only the host opens or closes a lot, and that grant sits on `lot`
        // so a single set() can write the player and the opening price
        // together and a single remove() can close it. A '.write' cascades
        // down, so it also lets the host write `lot/bid` directly: the
        // seat and step checks below constrain MANAGERS, not the host.
        // That is deliberate rather than overlooked — the host already
        // writes every sale, every price and every seat in this room, so
        // constraining their bids would be theatre. Their own raises go
        // through the same client transaction as everyone else's.
        // ============================================================
        "lot": {
          ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && root.child('rooms').child($room).child('host').child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['player', 'bid'])",

          "player": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
          "openedAt": { ".validate": "newData.isNumber()" },

          "bid": {
            // A raise. The one write a seated manager makes during an
            // auction, and the only rule in this file where two clients
            // genuinely race — so every clause here is about making the
            // outcome of that race decidable by the server alone:
            //
            //   the lot exists           data.exists() — no lot, no bids,
            //                            which is what closing a lot means
            //   same lot                 seq carried through untouched
            //   a real seat, THEIRS      the seat named in the write must
            //                            be held by the calling uid, so a
            //                            manager can neither bid without a
            //                            seat nor bid as somebody else
            //   not already winning      the winning seat must change
            //   the price only goes up   strictly greater, and by exactly
            //                            one of the three offered steps
            //   the lot is running       not paused, and `now` is still
            //                            before the deadline it carries
            //   the clock only extends   the new deadline is the old one
            //                            unchanged, or a later one no more
            //                            than 12s out — see below
            //
            // The steps are duplicated in LIVE_CFG.raiseSteps in
            // index.html; a step added there and not here is a button that
            // always fails.
            //
            // The 12000 in the last clause is LIVE_CFG.extendMs (10000) plus
            // LIVE_CFG.clockToleranceMs (2000). A bidder computes its
            // extended deadline from ITS estimate of server time and the
            // write then takes a network hop, so a device whose
            // .info/serverTimeOffset is a few hundred milliseconds
            // optimistic needs some give or every late bid it makes is
            // rejected. The tolerance is also the bound on the abuse: the
            // furthest any single bid can push a deadline is 12 seconds from
            // when the server sees it, whatever the client claims.
            ".write": "auth != null && $room.matches(/^[a-hjkmnp-z2-9]{12}$/) && data.exists() && newData.exists() && newData.child('seq').val() === data.child('seq').val() && newData.child('seat').isString() && root.child('rooms').child($room).child('seats').child(newData.child('seat').val()).child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid && newData.child('seat').val() !== data.child('seat').val() && newData.child('price').isNumber() && newData.child('price').val() > data.child('price').val() && (newData.child('price').val() === data.child('price').val() + 1 || newData.child('price').val() === data.child('price').val() + 5 || newData.child('price').val() === data.child('price').val() + 10) && !root.child('rooms').child($room).child('lot').child('paused').exists() && data.child('deadline').isNumber() && now < data.child('deadline').val() && newData.child('deadline').isNumber() && newData.child('deadline').val() >= data.child('deadline').val() && (newData.child('deadline').val() === data.child('deadline').val() || newData.child('deadline').val() <= now + 12000)",

            ".validate": "newData.hasChildren(['seq', 'price'])",

            "seq": { ".validate": "newData.isNumber()" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^m[0-9]{1,2}$/)" },
            "uid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "at": { ".validate": "newData.isNumber()" },
            "deadline": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },

          // Host-only by omission: no rule anywhere below `lot` grants a
          // non-host write, so the only '.write' these two are reachable
          // through is the host grant on `lot` itself. `paused` is only ever
          // true — a resumed lot deletes it rather than storing false, so
          // 'is this lot paused' is one existence check here and in the bid
          // rule above.
          "paused": { ".validate": "newData.isBoolean() && newData.val() === true" },
          "remainingMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000" },

          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
